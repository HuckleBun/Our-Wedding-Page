# Postgres (Neon). Copy both from Vercel > Storage > your database > .env.local tab.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"
ADMIN_PASSWORD="choose-a-password-8-plus-chars"

# Email (Resend) — see docs/EMAIL_SETUP.md
RESEND_API_KEY="re_????"
EMAIL_FROM="Micah & Emily <hello@yourdomain.com>"
COUPLE_NOTIFICATION_EMAIL="you@example.com,partner@example.com"
SITE_URL=""

# Private save-the-date page lives at /invite/<this value>. Use 12+ random characters;
# change it to revoke old links. Leave blank to turn the page off.
INVITE_PAGE_TOKEN=""

# Optional: key for signing admin sessions (16+ chars). Defaults to one derived from ADMIN_PASSWORD.
SESSION_SECRET=""
